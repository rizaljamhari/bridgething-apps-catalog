{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rizaljamhari.github.io/bridgething-apps-catalog/catalog.v1.schema.json",
  "title": "BridgeThing catalog.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "updated_at", "repo", "apps", "recommended_sources"],
  "properties": {
    "schema": { "const": "catalog.v1" },
    "updated_at": { "type": "string", "format": "date-time" },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "homepage"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "homepage": { "$ref": "#/$defs/httpsUrl" },
        "icon": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "apps": {
      "type": "array",
      "items": { "$ref": "#/$defs/app" }
    },
    "recommended_sources": { "type": "array" }
  },
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "author",
        "icon",
        "homepage",
        "source",
        "versions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "icon": { "$ref": "#/$defs/httpsUrl" },
        "homepage": { "$ref": "#/$defs/httpsUrl" },
        "source": { "$ref": "#/$defs/httpsUrl" },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/version" }
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "released_at", "download", "permissions"],
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "released_at": { "type": "string", "format": "date-time" },
        "download": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "size", "sha256"],
          "properties": {
            "url": { "$ref": "#/$defs/httpsUrl" },
            "size": { "type": "integer", "minimum": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "role": { "const": "launcher" },
        "provides_overlay": { "type": "boolean" },
        "min_libbridgething_version": { "$ref": "#/$defs/semver" },
        "changelog": { "type": "string" }
      }
    }
  }
}
